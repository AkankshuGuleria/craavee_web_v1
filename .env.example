# Craavee — environment variables
#
# Source of truth: docs/engineering/SECURITY_MODEL.md §3. This file
# documents every variable and its category; it contains NO real secrets
# — copy to .env.local (gitignored) per app and fill in real local/dev
# values. NEVER commit an actual filled-in .env file.
#
# Categories (Phase 2 prompt §29 / SECURITY_MODEL.md §3):
#   PUBLIC            — safe in any client bundle (Expo/Next.js)
#   SERVER_ONLY        — Next.js server-side only, never sent to the browser
#   EDGE_FUNCTION_ONLY  — Supabase Edge Functions only, set via
#                         `supabase secrets set`, never in a committed
#                         .env file, never in any client bundle
#   CI_ONLY            — CI pipeline only, not needed by application
#                         runtime code

# ============================================================
# PUBLIC — safe in apps/console, apps/store, apps/customer-runner bundles
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SENTRY_DSN=
POSTHOG_API_KEY=

# ============================================================
# EDGE_FUNCTION_ONLY — set via `supabase secrets set`, never committed,
# never bundled into any client
# ============================================================
SUPABASE_SERVICE_ROLE_KEY=

# ---- Payment gateway (Phase 5, D37 — Razorpay selected) ----
# PAYMENT_GATEWAY selects the adapter in supabase/functions/_shared/
# gateway/index.ts:
#   razorpay  (or unset) -> the real Razorpay adapter. REQUIRES all three
#             RAZORPAY_* values below; missing any -> the function fails
#             closed (never silently falls back to mock).
#   mock      -> the deterministic mock adapter. Permitted ONLY when
#             CRAAVEE_ALLOW_MOCK_CONTROL=1 AND CRAAVEE_ENV is neither
#             "production" nor "staging". Used by local dev + the
#             integration test suites. NEVER set this in a deployed env.
PAYMENT_GATEWAY=
# CRAAVEE_ENV: "development" (default) | "staging" | "production". In
# staging/production the mock adapter is impossible to activate and a
# missing gateway config is a hard startup failure (Phase 5 prompt §25).
CRAAVEE_ENV=
# RAZORPAY_KEY_ID is the publishable key id (rzp_test_… / rzp_live_…). It
# is returned to the client inside create_order's `checkoutParams` to
# open Razorpay Checkout — not a secret, but kept server-side here for
# simplicity (SECURITY_MODEL.md §3). Use rzp_test_ keys for dev+staging,
# rzp_live_ for production only (gated on merchant KYC).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The webhook signing secret configured in the Razorpay dashboard for the
# payment_webhook endpoint — used ONLY for HMAC-SHA256 signature
# verification against the raw request body. Never exposed to any client.
RAZORPAY_WEBHOOK_SECRET=

# Cashfree was NOT selected for Phase 5 (D37). These slots are kept
# documented for a future gateway switch; leave blank.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# ============================================================
# CI_ONLY — CI pipeline only (migration checks, pgTAP runs); never needed
# by application runtime code, which talks to Supabase via the client
# SDK, not a raw connection string
# ============================================================
SUPABASE_DB_URL=
EAS_PROJECT_ID=

# ============================================================
# Local development only (not a deployed-environment variable — used by
# scripts/run-db-tests.sh; safe default shown, matches `supabase start`'s
# standard local connection string)
# ============================================================
DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
