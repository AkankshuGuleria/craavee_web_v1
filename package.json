{
  "name": "craavee",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Craavee \u2014 hyperlocal quick-commerce for university campuses. Monorepo root (DEPLOYMENT_TOPOLOGY.md \u00a71).",
  "workspaces": [
    "apps/customer-runner",
    "apps/store",
    "apps/console",
    "packages/types",
    "packages/validation",
    "packages/api-contracts",
    "packages/ui"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @craavee/store -w @craavee/console",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "scripts/run-db-tests.sh",
    "functions:serve": "scripts/serve-functions.sh",
    "functions:test": "cd supabase/functions && deno test --allow-env _shared/gateway/gateway.test.ts",
    "functions:check": "cd supabase/functions && deno check create_order/index.ts validate_promo/index.ts expire_stale_reservations/index.ts payment_webhook/index.ts refund/index.ts mark_packed/index.ts mark_stock_out/index.ts claim_job/index.ts mark_picked_up/index.ts release_job/index.ts verify_delivery_code/index.ts admin_reassign/index.ts mark_delivery_failed/index.ts register_push_token/index.ts dispatch_notifications/index.ts _dev/serve.ts",
    "test:integration": "npm run test:integration -w @craavee/customer-runner",
    "gen": "supabase gen types typescript --local 2>/dev/null > packages/types/src/database.ts"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-config-next": "^16.3.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-css-interop": {
      "tailwindcss": "^3.4.19"
    },
    "nativewind": {
      "tailwindcss": "^3.4.19"
    }
  }
}
