# Craavee — customer-runner (Expo) environment variables.
#
# Expo's dotenv loading is scoped to this app's own directory, not the
# monorepo root — so this file exists here too, mirroring the relevant
# PUBLIC entries from the root ../../.env.example (source of truth for the
# full variable catalogue and category definitions: SECURITY_MODEL.md §3).
#
# Copy to .env.local (gitignored) and fill in the values `supabase status`
# prints (after `npm run db:start` from the repo root). Never commit a
# filled-in .env/.env.local — even though these two values are the
# well-known, identical-for-every-developer local Supabase demo keys, not
# real secrets, keeping the same discipline as every other environment
# avoids a habit that would matter once EXPO_PUBLIC_SUPABASE_URL points at
# a real project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
