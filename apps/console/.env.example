# Craavee — console (Next.js) environment variables.
#
# Next.js's dotenv loading is scoped to this app's own directory, not the
# monorepo root — mirrors the relevant PUBLIC entries from ../../.env.example
# (source of truth: SECURITY_MODEL.md §3). Copy to .env.local (gitignored)
# and fill in the values `supabase status` prints. Not yet exercised by
# any real page in this app (Phase 3 §17: utilities only, no operational
# auth/route guards here yet) — needed by src/lib/supabase/* and proxy.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
